{
  "name": "RulersAndBoxes",
  "description": "Small utility for measuring and aligning elements on a page.",
  "version": "1.0",
  "permissions": [
    "tabs", "http://*/*", "https://*/*"
  ],
  "browser_action": {
    "default_title": "Rulers and Boxes",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "manifest_version": 2,
  "web_accessible_resources": [
    "jquery-ui.css",
    "images/*.png"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dist/main.js"
      ],
      "css": [
        "jquery-ui.css"
      ]
    }
  ]
}
